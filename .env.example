# POWDERBURN environment. Copy to .env and fill every REQUIRED value.
# .env is gitignored from EP-001 M1 onward and is never committed, never logged.

# Exact Rust toolchain. Must be 1.85.0 or the literal string host.
RUSTUP_TOOLCHAIN=1.85.0

# Force cargo offline mode. Always 1 in this repository.
PB_CARGO_OFFLINE=1

# Absolute path to the repository root.
PB_HOME=/home/example/src/powderburn

# Absolute path to the authored asset tree.
PB_ASSET_ROOT=/home/example/src/powderburn/assets

# Absolute path to the golden-state corpus for determinism proofs.
PB_GOLDEN_DIR=/home/example/src/powderburn/tests/golden

# Absolute path to the scratch cache. Never committed.
PB_CACHE_DIR=/home/example/src/powderburn/.pbcache

# wgpu backend for headless frame capture. One of: gl, vulkan.
PB_HEADLESS_ADAPTER=gl

# Absolute path to the minisign secret key used to sign release artifacts.
PB_RELEASE_SIGNING_KEY=/home/example/.keys/powderburn.key

# Absolute path to the self-hosted release directory written by the hands-off deploy step.
PB_RELEASE_DIR=/srv/releases/powderburn

# OPTIONAL. itch.io butler API key, upload scope only. Leave empty to skip external publication.
PB_ITCH_API_KEY=
