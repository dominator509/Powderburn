// Sand multipliers are integer percentages to keep content deterministic.
[
    (
        id: "f_elk_creek_ring",
        display_name: "Elk Creek Ring",
        interests: ["Land acquisition", "Fraudulent bonds", "Political corruption", "Railroad speculation"],
        sand_multiplier_percent: 60,
        default_hostility: "Hostile",
        description: "Marcus Teague's criminal syndicate, operating under the cover of legitimate business in the Medicine Lodge territory. The Ring controls the local sheriff, the land office, and a network of hired guns. They are well-organized and ruthless, but their hired men lack conviction — they fight for pay, not principle.",
    ),
    (
        id: "f_bandits",
        display_name: "Bandits",
        interests: ["Theft", "Robbery", "Ransom", "Livestock rustling"],
        sand_multiplier_percent: 30,
        default_hostility: "Hostile",
        description: "Random outlaws, bushwhackers, and road agents who prey on the frontier's isolated settlements and travelers. They range from desperate men turned criminal to organized gangs like the James-Younger outfit. Lacking discipline, most will scatter when the shooting gets hot.",
    ),
    (
        id: "f_kiowa",
        display_name: "Kiowa",
        interests: ["Hunting grounds", "Treaty rights", "Territorial defense", "Horse raiding"],
        sand_multiplier_percent: 80,
        default_hostility: "Variable",
        description: "The Kiowa people, led by chiefs such as Satanta and Kicking Bird, control the southern plains from the Arkansas River to the Red River. Following the Medicine Lodge Treaty of 1867, they were confined to a reservation but continued to resist encroachment. Their warriors are among the most formidable light cavalry on the plains.",
    ),
    (
        id: "f_comanche",
        display_name: "Comanche",
        interests: ["Hunting grounds", "Territorial defense", "Horse raiding", "Warfare"],
        sand_multiplier_percent: 85,
        default_hostility: "Hostile",
        description: "The Lords of the South Plains. The Comanche are the dominant military power on the southern frontier, with a warrior society built around horsemanship and raiding. Their resistance to American expansion, led by chiefs like Quanah Parker, is fierce and uncompromising. They rarely surrender and fight with terrifying coordination.",
    ),
    (
        id: "f_cheyenne",
        display_name: "Southern Cheyenne",
        interests: ["Hunting grounds", "Treaty rights", "Territorial defense", "Diplomacy"],
        sand_multiplier_percent: 70,
        default_hostility: "Variable",
        description: "The Southern Cheyenne, under chiefs like Black Kettle and Roman Nose, occupy the country between the Arkansas and Platte Rivers. The Sand Creek Massacre of 1864 remains a raw wound. Some bands seek peace, others war — their posture depends heavily on the actions of the U.S. Army and Indian agents.",
    ),
    (
        id: "f_lakota",
        display_name: "Lakota Sioux",
        interests: ["Hunting grounds", "Territorial defense", "Warfare", "Spiritual sovereignty"],
        sand_multiplier_percent: 90,
        default_hostility: "Variable",
        description: "The Lakota, led by Sitting Bull, Crazy Horse, and Red Cloud, are the dominant power on the northern plains. They have already defeated the U.S. Army in Red Cloud's War (1866-1868) and secured the Powder River Country. Their warrior societies — the Kit Fox, the Crow Owners, the Dog Soldiers — fight with near-total commitment to the defense of their lands.",
    ),
    (
        id: "f_10th_cavalry",
        display_name: "10th Cavalry",
        interests: ["Military duty", "Law enforcement", "Fort defense", "Patrol"],
        sand_multiplier_percent: 85,
        default_hostility: "Friendly",
        description: "The Buffalo Soldiers of the 10th U.S. Cavalry Regiment. Composed of Black enlisted men and white officers, they are among the most disciplined and effective units on the frontier. They guard settlements, pursue outlaws, and patrol the border. Their nickname comes from the Cheyenne and Comanche, who respected their fierce fighting.",
    ),
    (
        id: "f_us_army",
        display_name: "U.S. Army",
        interests: ["Law enforcement", "Treaty enforcement", "Settlement protection", "Indian removal policy"],
        sand_multiplier_percent: 80,
        default_hostility: "Variable",
        description: "The regular U.S. Army on the frontier, operating out of forts like Fort Dodge, Fort Sill, and Fort Laramie. Their quality varies enormously — from battle-hardened veteran units to green recruits who can barely ride. Their posture toward the player is determined by the player's actions and the current political situation.",
    ),
    (
        id: "f_mexican",
        display_name: "Mexican Civilians & Soldiers",
        interests: ["Trade", "Settlement", "Cross-border commerce", "Self-defense"],
        sand_multiplier_percent: 60,
        default_hostility: "Neutral",
        description: "Mexican civilians, merchants, vaqueros, and federal troops encountered along the Rio Grande and in the borderlands. They are generally neutral but will defend themselves and their communities if threatened. The border is porous, and many Mexican settlements have suffered from cross-border raiding by both bandits and Native warriors.",
    ),
    (
        id: "f_tejano",
        display_name: "Tejano Settlers",
        interests: ["Settlement", "Ranching", "Trade", "Community defense"],
        sand_multiplier_percent: 65,
        default_hostility: "Friendly",
        description: "Texans of Mexican descent who have lived in the region for generations. They are ranchers, farmers, and merchants who maintain their own communities and cultural traditions. Generally friendly to travelers, they are wary of both Anglo land-grabbers and the violence that follows the frontier.",
    ),
    (
        id: "f_chinese",
        display_name: "Chinese Railroad Workers",
        interests: ["Labor", "Trade", "Self-preservation", "Community"],
        sand_multiplier_percent: 40,
        default_hostility: "Friendly",
        description: "Chinese laborers working on the transcontinental railroads and in frontier mining camps. They are hardworking, tightly-knit communities who keep to themselves. They are often targets of discrimination and violence, and will aid those who treat them fairly. Their camps are well-organized and their cooks are legendary.",
    ),
    (
        id: "f_pinkerton",
        display_name: "Pinkerton Agency",
        interests: ["Industrial security", "Strike-breaking", "Detection", "Union surveillance"],
        sand_multiplier_percent: 70,
        default_hostility: "Hostile",
        description: "Allan Pinkerton's National Detective Agency, hired by railroads, banks, and industrialists to protect their interests on the frontier. Pinkertons are professional, methodical, and utterly loyal to their employers. They operate with a combination of undercover investigation and armed force, and answers to no local law.",
    ),
    (
        id: "f_lawmen",
        display_name: "Lawmen & Posses",
        interests: ["Law enforcement", "Justice", "Community protection", "Reward collection"],
        sand_multiplier_percent: 65,
        default_hostility: "Neutral",
        description: "Town sheriffs, U.S. Marshals, deputized posses, and territorial judges. Their quality and integrity vary wildly — some are honest men doing a hard job, others are corrupt and in the pocket of the local power. They enforce the law as they see it, which may or may not align with actual justice.",
    ),
]
