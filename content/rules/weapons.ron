        smoke_output: 1,
        two_handed: false,
        first_year_available: 1873,
        historical_note: "The Peacemaker. Colt's landmark cartridge-firing revolver in .45 Long Colt, it became the signature sidearm of the Western frontier. Remained in continuous production for over 70 years. Its loading gate and ejector rod system set the standard for cartridge revolvers.",
        sources: ["Flayderman, 2007", "Wilson, 1985"],
    ),
    WeaponData(
