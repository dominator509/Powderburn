        base_misfire: 5,
        smoke_output: 1,
        two_handed: false,
        first_year_available: 1856,
        historical_note: "A nine-shot .42 caliber revolver with a secondary 20-gauge shotgun barrel beneath the main barrel. Designed by Dr. Jean Alexandre LeMat of New Orleans, it was primarily used by Confederate officers. The secondary scatter barrel could be pivoted to fire by flipping the hammer nose.",
        sources: ["Flayderman, 2007", "Albaugh, 1963"],
    ),
    (
        id: "colt_saa_1873",
        display_name: "Colt Single Action Army",
        damage_dice: (count: 1, sides: 8, bonus: 3),
        accuracy: 7,
        range_bands: (5, 15, 25, 40),
        ap_override: {},
        capacity: 6,
        reload_class: "Cartridge",
        fouling_rate: 2,
        base_misfire: 3,
        smoke_output: 1,
        two_handed: false,
        first_year_available: 1873,
        historical_note: "The Peacemaker. Colt's landmark cartridge-firing revolver in .45 Long Colt, it became the signature sidearm of the Western frontier. Remained in continuous production for over 70 years. Its loading gate and ejector rod system set the standard for cartridge revolvers.",
        sources: ["Flayderman, 2007", "Wilson, 1985"],
    ),
    (
        id: "henry_1860",
        display_name: "Henry Rifle",
        damage_dice: (count: 2, sides: 6, bonus: 1),
        accuracy: 8,
        range_bands: (10, 25, 50, 80),
        ap_override: {},
        capacity: 16,
        reload_class: "Cartridge",
        fouling_rate: 3,
        base_misfire: 5,
        smoke_output: 1,
        two_handed: true,
        first_year_available: 1860,
        historical_note: "The first practical lever-action repeating rifle, chambered in .44 Henry rimfire. Its sixteen-round magazine gave a single soldier the firepower of an entire platoon. Famously said to be 'loaded on Sunday and fired all week long.' Brass frame made it distinctive but heavy.",
        sources: ["Henshaw, 1993", "Worman, 2005"],
    ),
    (
