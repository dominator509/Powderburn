        fouling_rate: 3,
        base_misfire: 3,
        smoke_output: 1,
        two_handed: false,
        first_year_available: 1858,
        historical_note: "The principal rival to the Colt 1860, favored for its solid top strap which made it stronger and more accurate than the Colt open-top design. Remington produced approximately 132,000 during the Civil War.",
        sources: ["Flayderman, 2007", "Rose, 1995"],
    ),
    (
