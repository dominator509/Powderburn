        smoke_output: 1,
        two_handed: true,
        first_year_available: 1866,
        historical_note: "The 'Yellow Boy' — the first Winchester rifle, an improved Henry with a side loading gate designed by Nelson King. Its brass receiver gave it the nickname. Chambered in .44 Henry rimfire, it was famously carried by the Turkish army in the 1877 Russo-Turkish War.",
        sources: ["Henshaw, 1993", "Williamson, 1952"],
    ),
    (
        id: "winchester_1873",
        display_name: "Winchester Model 1873",
        damage_dice: (count: 2, sides: 6, bonus: 3),
        accuracy: 10,
        range_bands: (10, 25, 50, 80),
        ap_override: {},
        capacity: 15,
