[
    (
        id: "colt_army_1860",
        display_name: "Colt Model 1860 Army",
        damage_dice: (count: 1, sides: 8, bonus: 2),
        accuracy: 5,
        range_bands: (5, 15, 25, 40),
        ap_override: {},
        capacity: 6,
        reload_class: "CapAndBall",
        fouling_rate: 3,
        base_misfire: 4,
        smoke_output: 1,
        two_handed: false,
        first_year_available: 1860,
        historical_note: "The most widely used handgun of the Civil War era. A .44 caliber cap-and-ball revolver with an open-top frame and a distinctive barrel wedge. Over 200,000 were produced between 1860 and 1873.",
        sources: ["Flayderman, 2007", "Hounshell, 1984"],
    ),
    (
        id: "remington_1858",
        display_name: "Remington New Model Army",
        damage_dice: (count: 1, sides: 8, bonus: 2),
        accuracy: 6,
        range_bands: (5, 15, 25, 40),
        ap_override: {},
        capacity: 6,
        reload_class: "CapAndBall",
        fouling_rate: 3,
        base_misfire: 3,
        smoke_output: 1,
        two_handed: false,
        first_year_available: 1858,
        historical_note: "The principal rival to the Colt 1860, favored for its solid top strap which made it stronger and more accurate than the Colt open-top design. Remington produced approximately 132,000 during the Civil War.",
        sources: ["Flayderman, 2007", "Rose, 1995"],
    ),
    (
        id: "lemat_1856",
        display_name: "LeMat Revolver",
        damage_dice: (count: 1, sides: 8, bonus: 1),
        accuracy: 4,
        range_bands: (3, 10, 20, 35),
        ap_override: {},
        capacity: 9,
        reload_class: "CapAndBall",
        fouling_rate: 4,
        base_misfire: 5,
        smoke_output: 1,
        two_handed: false,
        first_year_available: 1856,
        historical_note: "A nine-shot .42 caliber revolver with a secondary 20-gauge shotgun barrel beneath the main barrel. Designed by Dr. Jean Alexandre LeMat of New Orleans, it was primarily used by Confederate officers. The secondary scatter barrel could be pivoted to fire by flipping the hammer nose.",
        sources: ["Flayderman, 2007", "Albaugh, 1963"],
    ),
    (
        id: "colt_saa_1873",
        display_name: "Colt Single Action Army",
        damage_dice: (count: 1, sides: 8, bonus: 3),
        accuracy: 7,
        range_bands: (5, 15, 25, 40),
        ap_override: {},
        capacity: 6,
        reload_class: "Cartridge",
        fouling_rate: 2,
        base_misfire: 3,
        smoke_output: 1,
        two_handed: false,
        first_year_available: 1873,
        historical_note: "The Peacemaker. Colt's landmark cartridge-firing revolver in .45 Long Colt, it became the signature sidearm of the Western frontier. Remained in continuous production for over 70 years. Its loading gate and ejector rod system set the standard for cartridge revolvers.",
        sources: ["Flayderman, 2007", "Wilson, 1985"],
    ),
    (
        id: "henry_1860",
        display_name: "Henry Rifle",
        damage_dice: (count: 2, sides: 6, bonus: 1),
        accuracy: 8,
        range_bands: (10, 25, 50, 80),
        ap_override: {},
        capacity: 16,
        reload_class: "Cartridge",
        fouling_rate: 3,
        base_misfire: 5,
        smoke_output: 1,
        two_handed: true,
        first_year_available: 1860,
        historical_note: "The first practical lever-action repeating rifle, chambered in .44 Henry rimfire. Its sixteen-round magazine gave a single soldier the firepower of an entire platoon. Famously said to be 'loaded on Sunday and fired all week long.' Brass frame made it distinctive but heavy.",
        sources: ["Henshaw, 1993", "Worman, 2005"],
    ),
    (
        id: "winchester_1866",
        display_name: "Winchester Model 1866",
        damage_dice: (count: 2, sides: 6, bonus: 2),
        accuracy: 9,
        range_bands: (10, 25, 50, 80),
        ap_override: {},
        capacity: 14,
        reload_class: "Cartridge",
        fouling_rate: 3,
        base_misfire: 4,
        smoke_output: 1,
        two_handed: true,
        first_year_available: 1866,
        historical_note: "The 'Yellow Boy' — the first Winchester rifle, an improved Henry with a side loading gate designed by Nelson King. Its brass receiver gave it the nickname. Chambered in .44 Henry rimfire, it was famously carried by the Turkish army in the 1877 Russo-Turkish War.",
        sources: ["Henshaw, 1993", "Williamson, 1952"],
    ),
    (
        id: "winchester_1873",
        display_name: "Winchester Model 1873",
        damage_dice: (count: 2, sides: 6, bonus: 3),
        accuracy: 10,
        range_bands: (10, 25, 50, 80),
        ap_override: {},
        capacity: 15,
        reload_class: "Cartridge",
        fouling_rate: 2,
        base_misfire: 3,
        smoke_output: 1,
        two_handed: true,
        first_year_available: 1873,
        historical_note: "The 'Gun that Won the West.' Chambered in .44-40 Winchester centerfire, it offered a stronger iron frame than the brass-framed 1866 and was the first Winchester to use a caliber also available in a revolver. Over 720,000 produced. Its 1876 Centennial variant was a larger-frame model in .45-75.",
        sources: ["Henshaw, 1993", "Williamson, 1952"],
    ),
    (
        id: "spencer_1860",
        display_name: "Spencer Carbine",
        damage_dice: (count: 2, sides: 8, bonus: 1),
        accuracy: 7,
        range_bands: (8, 20, 40, 65),
        ap_override: {},
        capacity: 7,
        reload_class: "Cartridge",
        fouling_rate: 4,
        base_misfire: 5,
        smoke_output: 1,
        two_handed: true,
        first_year_available: 1860,
        historical_note: "A seven-shot repeater with a tubular magazine in the stock, loaded through the buttplate. Chambered in .56-56 Spencer rimfire, it saw extensive use by Union cavalry late in the Civil War. More powerful than the Henry but slower to reload due to the buttstock magazine design.",
        sources: ["Henshaw, 1993", "Worman, 2005"],
    ),
    (
        id: "sharps_1874",
        display_name: "Sharps Model 1874",
        damage_dice: (count: 2, sides: 10, bonus: 4),
        accuracy: 12,
        range_bands: (15, 40, 80, 120),
        ap_override: {},
        capacity: 1,
        reload_class: "Breech",
        fouling_rate: 2,
        base_misfire: 4,
        smoke_output: 1,
        two_handed: true,
        first_year_available: 1874,
        historical_note: "The premier long-range rifle of the frontier, used by buffalo hunters and marksmen. Its falling-block action, invented by Christian Sharps in 1848, was renowned for accuracy at extreme ranges. The .45-70 Government cartridge could drop a bison at 500 yards. A buffalo hunter could kill 100 bison in a day with a Sharps.",
        sources: ["Sellers, 1978", "Venturino, 1999"],
    ),
    (
        id: "springfield_1873",
        display_name: "Trapdoor Springfield Model 1873",
        damage_dice: (count: 2, sides: 10, bonus: 3),
        accuracy: 11,
        range_bands: (12, 35, 70, 110),
        ap_override: {},
        capacity: 1,
        reload_class: "Breech",
        fouling_rate: 2,
        base_misfire: 6,
        smoke_output: 1,
        two_handed: true,
        first_year_available: 1873,
        historical_note: "The standard-issue U.S. Army rifle from 1873 through the 1890s. A single-shot .45-70 breech-loader converted from the muzzle-loading Springfield Model 1863, its hinged breechblock gave it the 'trapdoor' name. Used at the Battle of the Little Bighorn and throughout the Indian Wars.",
        sources: ["Frasca, 1975", "McAulay, 1996"],
    ),
    (
        id: "coach_gun",
        display_name: "10-Gauge Coach Gun",
        damage_dice: (count: 3, sides: 6, bonus: 0),
        accuracy: 6,
        range_bands: (3, 8, 15, 25),
        ap_override: {},
        capacity: 2,
        reload_class: "Breech",
        fouling_rate: 2,
        base_misfire: 4,
        smoke_output: 1,
        two_handed: true,
        first_year_available: 1850,
        historical_note: "A double-barrel 10-gauge shotgun with short barrels, designed for use by stagecoach guards and lawmen. The double barrels allowed two quick shots, and the wide spread of buckshot meant devastating effect at close range. Both barrels could be fired simultaneously for a single massive volley.",
        sources: ["Baer, 1990", "Hughes, 1995"],
    ),
    (
        id: "derringer",
        display_name: "Derringer",
        damage_dice: (count: 1, sides: 6, bonus: 1),
        accuracy: 3,
        range_bands: (2, 4, 8, 12),
        ap_override: {},
        capacity: 2,
        reload_class: "Cartridge",
        fouling_rate: 1,
        base_misfire: 5,
        smoke_output: 1,
        two_handed: false,
        first_year_available: 1865,
        historical_note: "A small, easily concealed pocket pistol typically chambered in .41 rimfire. Popularized by Henry Deringer of Philadelphia, it was the weapon of choice for gamblers and those who needed a discreet backup. The genericized 'derringer' spelling became common after many imitators appeared.",
        sources: ["Flayderman, 2007", "Parsons, 1950"],
    ),
    (
        id: "bowie_knife",
        display_name: "Bowie Knife",
        damage_dice: (count: 1, sides: 8, bonus: 2),
        accuracy: 8,
        range_bands: (1, 2, 3, 4),
        ap_override: {},
        capacity: 0,
        reload_class: "Melee",
        fouling_rate: 0,
        base_misfire: 0,
        smoke_output: 0,
        two_handed: false,
        first_year_available: 1830,
        historical_note: "The iconic American fighting knife, popularized by James Bowie at the Sandbar Fight of 1827. Characterized by a large clip-point blade with a sharpened false edge. A versatile tool and weapon carried throughout the frontier, it was as essential to a frontiersman as a firearm.",
        sources: ["Flayderman, 2007", "Peterson, 1958"],
    ),
    (
        id: "tomahawk",
        display_name: "Tomahawk",
        damage_dice: (count: 1, sides: 6, bonus: 3),
        accuracy: 6,
        range_bands: (3, 6, 9, 12),
        ap_override: {},
        capacity: 0,
        reload_class: "Melee",
        fouling_rate: 0,
        base_misfire: 0,
        smoke_output: 0,
        two_handed: false,
        first_year_available: 1700,
        historical_note: "A lightweight axe used by both Native Americans and European colonists as a tool and weapon. The iron trade tomahawk was a common frontier item, used for everything from woodcutting to combat. Could be thrown with lethal accuracy at short ranges.",
        sources: ["Peterson, 1958", "Russell, 1980"],
    ),
    (
        id: "lance",
        display_name: "Lance",
        damage_dice: (count: 2, sides: 6, bonus: 4),
        accuracy: 7,
        range_bands: (1, 3, 6, 9),
        ap_override: {},
        capacity: 0,
        reload_class: "Melee",
        fouling_rate: 0,
        base_misfire: 0,
        smoke_output: 0,
        two_handed: true,
        first_year_available: 1700,
        historical_note: "A long cavalry spear, typically 8 to 10 feet in length, used by Plains tribes and cavalry forces. The Comanche and Lakota were renowned lancers who could wield a lance with devastating effect from horseback. A well-driven lance strike carried the full force of the horse behind it.",
        sources: ["Secoy, 1953", "Ewers, 1955"],
    ),
    (
        id: "gatling",
        display_name: "Emplaced Gatling Gun",
        damage_dice: (count: 2, sides: 10, bonus: 2),
        accuracy: 14,
        range_bands: (12, 30, 60, 100),
        ap_override: {},
        capacity: 200,
        reload_class: "Tube",
        fouling_rate: 2,
        base_misfire: 4,
        smoke_output: 1,
        two_handed: true,
        first_year_available: 1862,
        historical_note: "Dr. Richard Gatling's hand-cranked machine gun, patented in 1862. A rotating cluster of barrels fed by a hopper, it could deliver 200 rounds per minute. Though adopted too late for significant Civil War use, it was used in post-war conflicts and was both terrifying and mechanically unreliable in the field. Appears exactly twice in the campaign.",
        sources: ["Berk, 1991", "Wahl, 1958"],
    ),
    // --- NEW WEAPONS (9 additions, total now 25) ---

    // Period-appropriate: Ash Bow (silent, Native American)
    (
        id: "ash_bow",
        display_name: "Ash Bow",
        damage_dice: (count: 1, sides: 10, bonus: 2),
        accuracy: 0,
        range_bands: (5, 12, 20, 30),
        ap_override: {},
        capacity: 1,
        reload_class: "Breech",
        fouling_rate: 0,
        base_misfire: 5,
        smoke_output: 0,
        two_handed: true,
        first_year_available: 1700,
        historical_note: "A self-bow carved from ash, favored by Kiowa and Lakota hunters. Silent and deadly, it leaves no smoke and gives no position away. Cannot be used with called shots due to the instinctive archer's release. Arrows must be retrieved after combat. A well-made ash bow could drive an arrow clean through a buffalo's ribcage at forty paces.",
        sources: ["Hämäläinen, 2008", "Ewers, 1955"],
    ),

    // Legendary: Thunderbird Rifle (blessed Winchester 1866)
    (
        id: "thunderbird_rifle",
        display_name: "Thunderbird Rifle",
        damage_dice: (count: 4, sides: 8, bonus: 2),
        accuracy: 10,
        range_bands: (10, 25, 50, 80),
        ap_override: {},
        capacity: 14,
        reload_class: "Cartridge",
        fouling_rate: 0,
        base_misfire: 1,
        smoke_output: 1,
        two_handed: true,
        first_year_available: 1866,
        historical_note: "LEGENDARY WEAPON — A Winchester Model 1866 with a gold-inlaid stock, said to have been blessed by the Thunderbird. Lightning crackles along the barrel when fired, and the weapon never jams or fouls. Its shots can arc between two targets standing close together. Appears only in Act III after completing the 'Storm on the Prairie' quest.",
        sources: ["In-game: Storm on the Prairie (Act III)"],
    ),

    // Legendary: Ghost Sidearm (ethereal Colt)
    (
        id: "ghost_sidearm",
        display_name: "Ghost Sidearm",
        damage_dice: (count: 4, sides: 8, bonus: 3),
        accuracy: 9,
        range_bands: (5, 15, 25, 40),
        ap_override: {},
        capacity: 6,
        reload_class: "Cartridge",
        fouling_rate: 0,
        base_misfire: 1,
        smoke_output: 0,
        two_handed: false,
        first_year_available: 1873,
        historical_note: "LEGENDARY WEAPON — The translucent, ethereal Colt of a dead lawman. Spectral shots appear as white-blue streaks through smoke and darkness. Ignores all armor — the ghostly bullets pass through flesh and steel alike. Cannot be dropped, traded, or stolen. Passed to a companion when its wielder falls in battle. The cylinder spins soundlessly; no hammer fall is heard, only the crack of spirit meeting flesh.",
        sources: ["In-game: Companion death event"],
    ),

    // Legendary: Iron Tomahawk (ceremonial, returns to hand)
    (
        id: "iron_tomahawk",
        display_name: "Iron Tomahawk",
        damage_dice: (count: 3, sides: 6, bonus: 2),
        accuracy: 8,
        range_bands: (3, 6, 9, 14),
        ap_override: {},
        capacity: 0,
        reload_class: "Melee",
        fouling_rate: 0,
        base_misfire: 0,
        smoke_output: 0,
        two_handed: false,
        first_year_available: 1800,
        historical_note: "LEGENDARY WEAPON — The ceremonial tomahawk of a fallen war chief, inlaid with silver and turquoise. Bound by spirit to its wielder, it returns to the hand after every throw at no action cost. The blade inflicts deep, bleeding wounds that cost the target additional AP on subsequent turns. Can be used with equal effectiveness in melee or as a thrown weapon.",
        sources: ["In-game: Act II side quest 'Chief's Legacy'"],
    ),

    // Mythic: Sun Rifle (meteorite, radiant)
    (
        id: "sun_rifle",
        display_name: "Sun Rifle",
        damage_dice: (count: 6, sides: 8, bonus: 0),
        accuracy: 14,
        range_bands: (15, 40, 80, 120),
        ap_override: {},
        capacity: 1,
        reload_class: "Breech",
        fouling_rate: 0,
        base_misfire: 2,
        smoke_output: 1,
        two_handed: true,
        first_year_available: 1869,
        historical_note: "MYTHIC WEAPON — Forged from a meteorite that fell during a total solar eclipse over the Nebraska Territory in 1869. Fires radiant bolts of blinding light that set targets ablaze. The rifle glows faintly in darkness and reveals hidden enemies in a wide radius when fired. Requires completing the 'Eclipse Sign' quest in Act II to acquire.",
        sources: ["In-game: Eclipse Sign (Act II)"],
    ),

    // Mythic: Moon Blade (ceremonial knife, night bonuses)
    (
        id: "moon_blade",
        display_name: "Moon Blade",
        damage_dice: (count: 1, sides: 8, bonus: 3),
        accuracy: 10,
        range_bands: (1, 2, 3, 4),
        ap_override: {},
        capacity: 0,
        reload_class: "Melee",
        fouling_rate: 0,
        base_misfire: 0,
        smoke_output: 0,
        two_handed: false,
        first_year_available: 1700,
        historical_note: "MYTHIC WEAPON — A Kiowa ceremonial knife with a blade of moonstone and meteoric iron. At night, the blade glows with pale silver light and deals additional damage. A critical hit under moonlight blinds the target for one tick. Grants night vision while equipped. Won during the 'Spirit Walk' vision quest, a ritual undergone only by those who have proven themselves on the warpath.",
        sources: ["In-game: Spirit Walk vision quest"],
    ),

    // Mythic: Earth Shaker (Spencer with explosive custom rounds)
    (
        id: "earth_shaker",
        display_name: "Earth Shaker",
        damage_dice: (count: 4, sides: 8, bonus: 2),
        accuracy: 8,
        range_bands: (8, 20, 40, 65),
        ap_override: {},
        capacity: 7,
        reload_class: "Cartridge",
        fouling_rate: 3,
        base_misfire: 6,
        smoke_output: 2,
        two_handed: true,
        first_year_available: 1860,
        historical_note: "MYTHIC WEAPON — A heavily modified Spencer carbine with a reinforced barrel and custom breech, designed to fire hand-crafted explosive rounds. Each shot detonates on impact with a blast radius of one tile, consuming both the round and anything near it. Custom ammunition must be crafted at a gunsmith's bench from sulfur, saltpeter, and iron filings. Unlocked by finding the three 'Earth Bones' hidden across all four acts of the campaign.",
        sources: ["In-game: Earth Bones hidden quest"],
    ),

    // Secret/Alien: Star Rifle (coherent light weapon from crash)
    (
        id: "star_rifle",
        display_name: "Star Rifle",
        damage_dice: (count: 5, sides: 10, bonus: 0),
        accuracy: 25,
        range_bands: (20, 50, 100, 150),
        ap_override: {"single": 6},
        capacity: 1,
        reload_class: "Special",
        fouling_rate: 0,
        base_misfire: 1,
        smoke_output: 0,
        two_handed: true,
        first_year_available: 1867,
        historical_note: "ALIEN WEAPON — A weapon not of this world, recovered from a crash site in the New Mexico desert in 1867. Fires bolts of coherent blue-white light that travel in a straight line, ignoring all cover and armor. The weapon recharges its own energy — infinite ammunition. Its alien nature makes aimed called shots impossible; the wielder simply points and fires. Glows blue-white when charged. Costs 6 AP per shot. Found only in the hidden quest 'What Fell From Heaven,' triggered by specific dialogue choices in the Act I camp.",
        sources: ["In-game: What Fell From Heaven (Act I hidden quest)"],
    ),

    // Secret/Alien: Void Pistol (companion to Star Rifle)
    (
        id: "void_pistol",
        display_name: "Void Pistol",
        damage_dice: (count: 3, sides: 8, bonus: 2),
        accuracy: 20,
        range_bands: (5, 15, 25, 40),
        ap_override: {"single": 4},
        capacity: 1,
        reload_class: "Special",
        fouling_rate: 0,
        base_misfire: 1,
        smoke_output: 0,
        two_handed: false,
        first_year_available: 1867,
        historical_note: "ALIEN WEAPON — Companion sidearm to the Star Rifle, found in the same crash site. Fires spheres of gravitational distortion that pull the target one tile closer to the shooter on a successful hit. The distortion wave parts smoke and fog completely, ignoring all smoke penalties to accuracy. Its dark metal surface seems to drink the light around it. Found in the hidden quest 'What Fell From Heaven.'",
        sources: ["In-game: What Fell From Heaven (Act I hidden quest)"],
    ),

    // God Weapon: Judgement (the Ledger itself)
    (
        id: "judgement",
        display_name: "Judgement",
        damage_dice: (count: 1, sides: 1, bonus: 0),
        accuracy: 999,
        range_bands: (10, 25, 50, 100),
        ap_override: {},
        capacity: 1,
        reload_class: "Special",
        fouling_rate: 0,
        base_misfire: 0,
        smoke_output: 0,
        two_handed: true,
        first_year_available: 1878,
        historical_note: "GOD WEAPON — The Ledger itself, manifested as a weapon in the final confrontation with Teague. Its damage equals the total Ledger Weight — the number of named deaths written into its pages. This weapon is earned only by never sparing those who deserve the ledger. Emits pure white light; no to-hit roll is needed, as Judgement cannot miss. Only usable in the final battle of Act IV. The pages of the Ledger flare with white fire, and every name written in it burns bright before being hurled at the enemy.",
        sources: ["In-game: Act IV final confrontation"],
    ),
]
