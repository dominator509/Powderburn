        two_handed: false,
        first_year_available: 1860,
        historical_note: "The most widely used handgun of the Civil War era. A .44 caliber cap-and-ball revolver with an open-top frame and a distinctive barrel wedge. Over 200,000 were produced between 1860 and 1873.",
        sources: ["Flayderman, 2007", "Hounshell, 1984"],
    ),
    (
        id: "remington_1858",
        display_name: "Remington New Model Army",
        damage_dice: (count: 1, sides: 8, bonus: 2),
