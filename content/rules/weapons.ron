        smoke_output: 1,
        two_handed: false,
        first_year_available: 1856,
        historical_note: "A nine-shot .42 caliber revolver with a secondary 20-gauge shotgun barrel beneath the main barrel. Designed by Dr. Jean Alexandre LeMat of New Orleans, it was primarily used by Confederate officers. The secondary scatter barrel could be pivoted to fire by flipping the hammer nose.",
        sources: ["Flayderman, 2007", "Albaugh, 1963"],
    ),
    WeaponData(
        id: "colt_saa_1873",
        display_name: "Colt Single Action Army",
