[
  (id:"dlg_naomi_a1",act:1,node_id:Some("camp_01_ledger_fire"),requires_flags:["a1_treaty_witnessed"],requires_alive:["c_naomi"],max_ledger_weight:None,lines:[(speaker_id:"c_naomi",language:"en",original:"A gun remembers neglect. Rust is only a debt somebody chose not to pay.",translation:None,subtitle:"Naomi says a gun remembers neglect, and rust is an unpaid debt.")]),
  (id:"dlg_naomi_a2",act:2,node_id:Some("camp_05_mile_high"),requires_flags:["a2_promontory_present"],requires_alive:["c_naomi"],max_ledger_weight:None,lines:[(speaker_id:"c_naomi",language:"en",original:"They call a machine progress when the profit belongs to someone far away.",translation:None,subtitle:"Naomi questions who profits when a machine is called progress.")]),
  (id:"dlg_naomi_a3",act:3,node_id:Some("camp_07_hide_smoke"),requires_flags:["a3_adobe_walls_survived"],requires_alive:["c_naomi"],max_ledger_weight:None,lines:[(speaker_id:"c_naomi",language:"en",original:"The hide men count animals the way Teague counts people: only after they are gone.",translation:None,subtitle:"Naomi compares the hide trade's counting to Teague's accounting.")]),
  (id:"dlg_naomi_a4",act:4,node_id:Some("camp_10_new_ground"),requires_flags:["a2_patron_ruined"],requires_alive:["c_naomi"],max_ledger_weight:None,lines:[(speaker_id:"c_naomi",language:"en",original:"Nicodemus is not a promise made to us. It is work people chose to do for themselves.",translation:None,subtitle:"Naomi says Nicodemus is work people chose to do for themselves.")]),
]
