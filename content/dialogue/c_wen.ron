[
  (id:"dlg_wen_a1",act:1,node_id:Some("camp_03_eastbound"),requires_flags:["a1_treaty_witnessed"],requires_alive:["c_wen"],max_ledger_weight:None,lines:[(speaker_id:"c_wen",language:"en",original:"Powder breaks stone cleanly. Men use it less carefully on one another.",translation:None,subtitle:"Wen says blasting powder breaks stone more cleanly than men use it against one another.")]),
  (id:"dlg_wen_a2",act:2,node_id:Some("camp_06_broken_ties"),requires_flags:["a2_promontory_present"],requires_alive:["c_wen"],max_ledger_weight:None,lines:[(speaker_id:"c_wen",language:"en",original:"At Promontory they photographed the bosses. The hands who cut the grade stood outside the frame.",translation:None,subtitle:"Wen says the Promontory photograph excluded the workers who cut the grade.")]),
  (id:"dlg_wen_a3",act:3,node_id:Some("camp_07_hide_smoke"),requires_flags:["a3_adobe_walls_survived"],requires_alive:["c_wen"],max_ledger_weight:None,lines:[(speaker_id:"c_wen",language:"en",original:"A market can make killing look like weather. It is still a choice made by people.",translation:None,subtitle:"Wen says markets can disguise killing as weather, but it remains a human choice.")]),
  (id:"dlg_wen_a4",act:4,node_id:Some("camp_10_new_ground"),requires_flags:["a2_patron_ruined"],requires_alive:["c_wen"],max_ledger_weight:None,lines:[(speaker_id:"c_wen",language:"yue",original:"條路唔會記得起路嘅人。",translation:Some("The road will not remember the people who built it."),subtitle:"Wen says in Cantonese that the road will not remember the people who built it.")]),
]
