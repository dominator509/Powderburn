[
  (id:"dlg_doyle_a1",act:1,node_id:Some("camp_02_winter_count"),requires_flags:["a1_treaty_witnessed"],requires_alive:["c_doyle"],max_ledger_weight:None,lines:[(speaker_id:"c_doyle",language:"en",original:"An order tells you where to stand. It does not tell you how to live with standing there.",translation:None,subtitle:"Doyle says an order cannot tell a soldier how to live with obeying it.")]),
  (id:"dlg_doyle_a2",act:2,node_id:Some("camp_05_mile_high"),requires_flags:["a2_promontory_present"],requires_alive:["c_doyle"],max_ledger_weight:None,lines:[(speaker_id:"c_doyle",language:"en",original:"Uniform or work shirt, a man knows when somebody has decided his labor is cheap.",translation:None,subtitle:"Doyle says workers recognize when others have decided their labor is cheap.")]),
  (id:"dlg_doyle_a3",act:3,node_id:Some("camp_08_red_dust"),requires_flags:["a3_adobe_walls_survived"],requires_alive:["c_doyle"],max_ledger_weight:None,lines:[(speaker_id:"c_doyle",language:"en",original:"I can keep the column alive and still say the campaign is wrong. Both facts cost me.",translation:None,subtitle:"Doyle says duty and judgment can both be true, and both cost him.")]),
  (id:"dlg_doyle_a4",act:4,node_id:Some("camp_10_new_ground"),requires_flags:["a2_patron_ruined"],requires_alive:["c_doyle"],max_ledger_weight:None,lines:[(speaker_id:"c_doyle",language:"en",original:"Federal blue left the South, but the promises did not march west with us.",translation:None,subtitle:"Doyle says federal withdrawal left Reconstruction's promises behind.")]),
]
