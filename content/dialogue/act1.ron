[
  (id:"dlg_act1_ledger_begins",act:1,node_id:Some("camp_01_ledger_fire"),requires_flags:["a1_treaty_witnessed"],requires_alive:["c_elias","c_naomi"],max_ledger_weight:Some(4),lines:[
    (speaker_id:"c_elias",language:"en",original:"I used to think the signature was the sin. Josiah taught me the sin was walking away after I signed.",translation:None,subtitle:"Elias admits that abandoning the people harmed by his signature was worse than the signature itself."),
    (speaker_id:"c_naomi",language:"en",original:"Josiah did not teach you anything. He died. You are learning because I refused to.",translation:None,subtitle:"Naomi refuses to let Elias turn her brother's murder into his redemption."),
    (speaker_id:"c_elias",language:"en",original:"Then no redemption. Only the work.",translation:None,subtitle:"Elias gives up the language of redemption and commits to the work ahead."),
  ]),
]
