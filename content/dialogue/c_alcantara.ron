[
  (id:"dlg_alcantara_a1",act:1,node_id:Some("camp_01_ledger_fire"),requires_flags:["a1_treaty_witnessed"],requires_alive:["c_alcantara"],max_ledger_weight:None,lines:[(speaker_id:"c_alcantara",language:"en",original:"A surgeon and a priest both meet people after certainty has failed them.",translation:None,subtitle:"Alcantara says surgeons and priests meet people after certainty fails.")]),
  (id:"dlg_alcantara_a2",act:2,node_id:Some("camp_04_cinders"),requires_flags:["a2_promontory_present"],requires_alive:["c_alcantara"],max_ledger_weight:None,lines:[(speaker_id:"c_alcantara",language:"en",original:"Steel joins the coasts. It also carries every sickness faster.",translation:None,subtitle:"Alcantara says the railroad joins coasts and accelerates disease.")]),
  (id:"dlg_alcantara_a3",act:3,node_id:Some("camp_08_red_dust"),requires_flags:["a3_adobe_walls_survived"],requires_alive:["c_alcantara"],max_ledger_weight:None,lines:[(speaker_id:"c_alcantara",language:"en",original:"Dust in a wound is honest. It never claims the fever is divine judgment.",translation:None,subtitle:"Alcantara rejects calling fever divine judgment.")]),
  (id:"dlg_alcantara_a4",act:4,node_id:Some("camp_11_names_carried"),requires_flags:["a3_adobe_walls_survived"],requires_alive:["c_alcantara"],max_ledger_weight:None,lines:[(speaker_id:"c_alcantara",language:"en",original:"In Memphis we will treat whoever reaches the door. Fear may choose sides; fever does not.",translation:None,subtitle:"Alcantara says fear chooses sides but fever does not.")]),
]
