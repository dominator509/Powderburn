[
  (id:"dlg_ruelas_a1",act:1,node_id:Some("camp_01_ledger_fire"),requires_flags:["a1_treaty_witnessed"],requires_alive:["c_ruelas"],max_ledger_weight:None,lines:[(speaker_id:"c_ruelas",language:"en",original:"A boundary on a court map can cut through a family older than the courthouse.",translation:None,subtitle:"Ruelas says a court boundary can divide a family older than the courthouse.")]),
  (id:"dlg_ruelas_a2",act:2,node_id:Some("camp_06_broken_ties"),requires_flags:["a2_promontory_present"],requires_alive:["c_ruelas"],max_ledger_weight:None,lines:[(speaker_id:"c_ruelas",language:"en",original:"The railroad surveyors call the land empty when they do not recognize the owners.",translation:None,subtitle:"Ruelas says surveyors call land empty when they do not recognize its owners.")]),
  (id:"dlg_ruelas_a3",act:3,node_id:Some("camp_08_red_dust"),requires_flags:["a3_adobe_walls_survived"],requires_alive:["c_ruelas"],max_ledger_weight:None,lines:[(speaker_id:"c_ruelas",language:"en",original:"A herd can be rebuilt. A water right taken on paper may never come home.",translation:None,subtitle:"Ruelas says livestock can be rebuilt, but a stolen water right may never return.")]),
  (id:"dlg_ruelas_a4",act:4,node_id:Some("camp_12_last_account"),requires_flags:["a4_salt_war_sided_with_ruelas"],requires_alive:["c_ruelas"],max_ledger_weight:None,lines:[(speaker_id:"c_ruelas",language:"es",original:"La sal era de todos antes de que un papel dijera lo contrario.",translation:Some("The salt belonged to everyone before a paper said otherwise."),subtitle:"Ruelas says in Spanish that the salt belonged to everyone before a paper said otherwise.")]),
